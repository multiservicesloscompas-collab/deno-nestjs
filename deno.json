{
  "tasks": {
    "dev": "deno run -A --env --watch src/app/main.ts",
    "start": "deno run -A --env src/app/main.ts",
    "build": "deno check src/app/main.ts"
  },
  "imports": {
    "@nestjs/common": "npm:@nestjs/common@^10.0.0",
    "@nestjs/core": "npm:@nestjs/core@^10.0.0",
    "@google/generative-ai": "npm:@google/generative-ai@^0.21.0"
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  },
  "nodeModulesDir": "auto"
}
