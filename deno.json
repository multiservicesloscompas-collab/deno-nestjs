{
  "tasks": {
    "dev": "deno run -A --env --watch src/app/main.ts",
    "start": "deno run -A --env src/app/main.ts",
    "build": "deno check src/app/main.ts"
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  },
  "nodeModulesDir": "auto"
}
